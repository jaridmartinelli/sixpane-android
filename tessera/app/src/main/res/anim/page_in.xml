<!-- Full-screen page opens: rises slightly and fades in. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic" android:shareInterpolator="true">
    <translate android:fromYDelta="6%" android:toYDelta="0" android:duration="220" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="220" />
</set>
